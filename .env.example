# Copy to .env and fill in real values. Never commit .env.

# Cloudflare quick-tunnel token (from the Cloudflare dashboard).
TUNNEL_TOKEN=

# Public API key. Clients must send X-API-Key with this value (spec §6.1).
KVP_API_KEY=

# --- optional tuning (all have sane defaults) ---
KVP_PORT=:8080
KVP_METRICS_PORT=127.0.0.1:9090
KVP_DB_PATH=/app/kvp.db
KVP_MAX_DB_BYTES=1073741824
KVP_CLEANUP_BATCH_SIZE=1000
KVP_CLEANUP_MAX_RUNS=20
KVP_SIZE_CLEANUP_THROTTLE=1m
KVP_CLEANUP_INTERVAL=1m
KVP_MAX_BODY_BYTES=1048576
KVP_MAX_KEY_BYTES=256
KVP_TTL=24h
KVP_RATE_LIMIT_RPS=10
KVP_RATE_LIMIT_BURST=20
KVP_TRUSTED_PROXIES=
KVP_LOG_LEVEL=info
KVP_OTEL_SERVICE_NAME=kvp
KVP_OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
KVP_BACKUP_DIR=
KVP_BACKUP_INTERVAL=6h
KVP_BACKUP_RETENTION=5
KVP_SHUTDOWN_TIMEOUT=15s

# --- GrafanaCloud observability (empty => local fallback via collector) ---
GRAFANA_CLOUD_STACK_ID=
GRAFANA_CLOUD_API_TOKEN=
GRAFANA_CLOUD_REGION=
