{
  "uid": "kvp-overview",
  "title": "KVP Store Overview",
  "tags": ["kvp"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "__inputs": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second by route",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "targets": [{
        "expr": "sum by (route) (rate(kvp_http_requests_total[5m]))",
        "legendFormat": "{{route}}",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests per second by status",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "targets": [{
        "expr": "sum by (status) (rate(kvp_http_requests_total[5m]))",
        "legendFormat": "{{status}}",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(kvp_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(kvp_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(kvp_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Error rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "targets": [{
        "expr": "sum(rate(kvp_http_errors_total[5m])) / clamp_min(sum(rate(kvp_http_requests_total[5m])), 0.001)",
        "legendFormat": "error rate",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "max": 1 },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "DB size vs limit",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "targets": [
        { "expr": "kvp_db_size_bytes", "legendFormat": "size", "refId": "A" },
        { "expr": "kvp_db_size_limit_bytes", "legendFormat": "limit", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "DB rows",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "targets": [{
        "expr": "kvp_db_rows",
        "legendFormat": "rows",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Cleanup: runs and deleted keys",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "targets": [
        { "expr": "sum by (kind) (rate(kvp_cleanup_runs_total[5m]))", "legendFormat": "{{kind}} runs", "refId": "A" },
        { "expr": "sum by (kind) (rate(kvp_cleanup_deleted_keys_total[5m]))", "legendFormat": "{{kind}} deleted", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Go runtime",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "targets": [
        { "expr": "go_goroutines", "legendFormat": "goroutines", "refId": "A" },
        { "expr": "rate(go_gc_duration_seconds_sum[5m]) / clamp_min(rate(go_gc_duration_seconds_count[5m]), 0.001)", "legendFormat": "gc avg", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}
